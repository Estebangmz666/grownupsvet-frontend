# Copia este archivo a `.env.local` y ajusta los valores.
# Solo las variables con prefijo EXPO_PUBLIC_ quedan embebidas en el bundle
# y son visibles para cualquiera que abra la aplicación: nunca pongas aquí
# contraseñas, claves privadas ni tokens.

# Web (por defecto): ruta relativa. El gateway de proxy/ reenvía /api/* al
# backend desde el mismo origen, por lo que no se necesita CORS.
# EXPO_PUBLIC_API_BASE_URL=/api/v1

# Desarrollo web con HMR: Metro sirve en 8081 y el gateway en 8080.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Emulador de Android con el backend en la máquina anfitriona.
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1

# Backend desplegado (solo nativo; en web da 403 de CORS sin el gateway).
# EXPO_PUBLIC_API_BASE_URL=https://grownupsvet-backend-w5glrcsyda-uc.a.run.app/api/v1
